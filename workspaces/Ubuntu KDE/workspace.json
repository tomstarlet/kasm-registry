{
  "friendly_name": "Ubuntu KDE",
  "image_src": "ubuntu-kde.png",
  "description": "Ubuntu with the KDE desktop environment.",
  "name": "lscr.io/linuxserver/webtop:ubuntu-kde",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
