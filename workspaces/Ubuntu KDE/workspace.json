    ],
    "user": 1000,
    "environment": {
      "HOME": "/home/kasm-user"
    }
  },
  "exec_config": {},
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "lscr.io/linuxserver/webtop:ubuntu-kde",
      "uncompressed_size_mb": 2200,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
